          "name": "Affirm List Transaction Events",
          "request": {
            "name": "Affirm List Transaction Events",
            "description": {
              "content": "Returns a paginated list of transaction event records for the authenticated merchant. Each event documents a change in a transaction's lifecycle, such as an authorization, capture, refund, or void. Events include timestamps, amounts, fees, and reference identifiers for reconciliation.",
              "type": "text/plain"
            },
